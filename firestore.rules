rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /croquis_escalada/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creadoPor;

      // El autor cambia lo que quiera
      allow update: if request.auth != null && request.auth.uid == resource.data.creadoPor;

      // Editores aceptados o invitados: el contenido, nunca el autor ni la lista de editores
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.get('editores', [])
            || request.auth.token.email in resource.data.get('editoresEmail', []))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['infoCroquis', 'fotos', 'imagenUrl', 'vias', 'formas', 'visibilidad', 'abiertoPropuestas', 'updatedAt']);

      // Proponer cambios al autor: solo añadir una capa
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['capas'])
        && request.resource.data.capas.size() == resource.data.get('capas', []).size() + 1;

      // Quien creó una escuela puede sacar de ella un croquis (solo vaciar el campo escuela).
      // desvinculadoDe indica la escuela, y se comprueba que el croquis pertenece a ella.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['infoCroquis', 'desvinculadoDe'])
        && request.resource.data.infoCroquis.diff(resource.data.infoCroquis).affectedKeys().hasOnly(['escuela'])
        && request.resource.data.infoCroquis.escuela == ''
        && get(/databases/$(database)/documents/escuelas/$(request.resource.data.desvinculadoDe)).data.creadoPor == request.auth.uid
        && get(/databases/$(database)/documents/escuelas/$(request.resource.data.desvinculadoDe)).data.nombre.trim().lower()
             == resource.data.infoCroquis.escuela.trim().lower();

      // Comentarios en subcollección
      match /comentarios/{comentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.autorUid ||
          request.auth.uid == get(/databases/$(database)/documents/croquis_escalada/$(docId)).data.creadoPor ||
          request.auth.token.email == 'goladen@gmail.com'
        );
      }
    }

    // Enlaces de tarjeta de vía. El id del documento es el secreto: se puede abrir
    // conociéndolo, pero solo quien lo creó puede listar los suyos.
    match /tarjetas_via/{token} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.creadoPor == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.creadoPor == request.auth.uid
        && (get(/databases/$(database)/documents/croquis_escalada/$(request.resource.data.croquisId)).data.creadoPor == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/croquis_escalada/$(request.resource.data.croquisId)).data.get('editores', [])
            || request.auth.token.email in get(/databases/$(database)/documents/croquis_escalada/$(request.resource.data.croquisId)).data.get('editoresEmail', []));
      allow delete: if request.auth != null && (resource.data.creadoPor == request.auth.uid
        || get(/databases/$(database)/documents/croquis_escalada/$(resource.data.croquisId)).data.creadoPor == request.auth.uid);
    }

    // Enlaces para proponer cambios en todo un croquis. Igual que las tarjetas de vía, sin viaId.
    match /tarjetas_croquis/{token} {
      function croquisDe(id) { return get(/databases/$(database)/documents/croquis_escalada/$(id)).data; }
      allow get: if true;
      allow list: if request.auth != null && resource.data.creadoPor == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['croquisId', 'creadoPor', 'createdAt'])
        && request.resource.data.creadoPor == request.auth.uid
        && (croquisDe(request.resource.data.croquisId).creadoPor == request.auth.uid
            || request.auth.uid in croquisDe(request.resource.data.croquisId).get('editores', [])
            || request.auth.token.email in croquisDe(request.resource.data.croquisId).get('editoresEmail', []));
      allow delete: if request.auth != null && (resource.data.creadoPor == request.auth.uid
        || croquisDe(resource.data.croquisId).creadoPor == request.auth.uid);
    }

    // Propuestas enviadas desde el enlace de un croquis, sin registrarse: varias vías
    // modificadas o nuevas en una sola propuesta, dirigida a quien creó el enlace.
    match /propuestas_croquis/{id} {
      function tarjeta() {
        return get(/databases/$(database)/documents/tarjetas_croquis/$(request.resource.data.token)).data;
      }
      allow create: if request.resource.data.keys().hasOnly(['token', 'croquisId', 'paraUid', 'autorNombre', 'cambios', 'estado', 'createdAt'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre.size() > 0 && request.resource.data.autorNombre.size() <= 60
        && request.resource.data.cambios is list
        && request.resource.data.cambios.size() > 0 && request.resource.data.cambios.size() <= 100
        && tarjeta().croquisId == request.resource.data.croquisId
        && tarjeta().creadoPor == request.resource.data.paraUid;
      // Croquis abierto a propuestas: cualquiera, sin enlace, dirigida al autor del croquis
      allow create: if request.resource.data.keys().hasOnly(['croquisId', 'paraUid', 'autorNombre', 'cambios', 'estado', 'createdAt'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre.size() > 0 && request.resource.data.autorNombre.size() <= 60
        && request.resource.data.cambios is list
        && request.resource.data.cambios.size() > 0 && request.resource.data.cambios.size() <= 100
        && get(/databases/$(database)/documents/croquis_escalada/$(request.resource.data.croquisId)).data.get('abiertoPropuestas', false) == true
        && get(/databases/$(database)/documents/croquis_escalada/$(request.resource.data.croquisId)).data.creadoPor == request.resource.data.paraUid;
      allow read, delete: if request.auth != null && resource.data.paraUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.paraUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
    }

    // Propuestas enviadas desde una tarjeta de vía, sin necesidad de registrarse.
    // Solo se aceptan con un enlace vigente y van dirigidas a quien lo creó.
    match /propuestas_via/{id} {
      function tarjeta() {
        return get(/databases/$(database)/documents/tarjetas_via/$(request.resource.data.token)).data;
      }
      allow create: if request.resource.data.keys().hasOnly(['token', 'croquisId', 'viaId', 'paraUid', 'autorNombre', 'cambios', 'estado', 'createdAt'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre.size() > 0 && request.resource.data.autorNombre.size() <= 60
        && request.resource.data.cambios.keys().hasOnly(['info', 'trazado'])
        && tarjeta().croquisId == request.resource.data.croquisId
        && tarjeta().viaId == request.resource.data.viaId
        && tarjeta().creadoPor == request.resource.data.paraUid;
      // Propuestas de un equipador vinculado sobre sus vías, dirigidas a quien creó el croquis.
      // Solo puede ponerse a sí mismo como equipador y no cambia el trazado.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['croquisId', 'viaId', 'paraUid', 'autorNombre', 'autorUid', 'equipadorId', 'cambios', 'estado', 'createdAt'])
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre.size() > 0 && request.resource.data.autorNombre.size() <= 60
        && request.resource.data.cambios.keys().hasOnly(['info', 'trazado'])
        && request.resource.data.cambios.get('trazado', null) == null
        && request.resource.data.cambios.info.equipadorId == request.resource.data.equipadorId
        && get(/databases/$(database)/documents/equipadores/$(request.resource.data.equipadorId)).data.get('usuarioUid', null) == request.auth.uid
        && get(/databases/$(database)/documents/croquis_escalada/$(request.resource.data.croquisId)).data.creadoPor == request.resource.data.paraUid;
      allow read, delete: if request.auth != null && resource.data.get('autorUid', null) == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.paraUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.paraUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
    }

    // Fichas de equipadores: se crean al indicar el equipador de una vía.
    // Un usuario puede pedir gestionar una ficha; la administración la vincula (usuarioUid).
    match /equipadores/{id} {
      function cambia() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function sinDueno() { return resource.data.get('usuarioUid', null) == null; }

      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0
        && !request.resource.data.keys().hasAny(['usuarioUid', 'oculto', 'nombreVisible', 'solicitudVinculo', 'vinculoPendiente']);

      // Administración: todo, incluido aprobar o rechazar vínculos
      allow update, delete: if request.auth != null && request.auth.token.email == 'goladen@gmail.com';

      // Quien creó una ficha sin dueño puede corregir el nombre o borrarla
      allow update: if request.auth != null && resource.data.creadoPor == request.auth.uid && sinDueno()
        && cambia().hasOnly(['nombre'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0;
      allow delete: if request.auth != null && resource.data.creadoPor == request.auth.uid && sinDueno();

      // El equipador vinculado elige su nombre visible y si la ficha está oculta, o deja de gestionarla
      allow update: if request.auth != null && resource.data.get('usuarioUid', null) == request.auth.uid
        && cambia().hasOnly(['nombreVisible', 'oculto', 'usuarioUid'])
        && request.resource.data.get('nombreVisible', '') is string
        && request.resource.data.get('nombreVisible', '').size() <= 60
        && request.resource.data.get('oculto', false) is bool
        && (request.resource.data.get('usuarioUid', null) == request.auth.uid
            || request.resource.data.get('usuarioUid', null) == null);

      // Pedir gestionar una ficha sin dueño (si nadie lo ha pedido ya) o retirar la propia solicitud
      allow update: if request.auth != null && sinDueno()
        && cambia().hasOnly(['solicitudVinculo', 'vinculoPendiente'])
        && ((resource.data.get('vinculoPendiente', false) == false
             && request.resource.data.vinculoPendiente == true
             && request.resource.data.solicitudVinculo.uid == request.auth.uid)
          || (resource.data.get('solicitudVinculo', {}).get('uid', '') == request.auth.uid
             && request.resource.data.vinculoPendiente == false
             && request.resource.data.solicitudVinculo == null));
    }

    match /solicitudes_edicion/{id} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.autorUid ||
        request.auth.uid == resource.data.solicitanteUid
      );
      allow create: if request.auth != null
        && request.resource.data.solicitanteUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.autorUid == request.auth.uid;
    }

    match /escuelas/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.creadoPor;
    }

    match /rocodromos/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.creadoPor == request.auth.uid;
      allow delete: if request.auth != null && resource.data.creadoPor == request.auth.uid;
      allow update: if request.auth != null && resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPor == request.auth.uid;

      // Hacerse miembro o dejar de serlo: solo el propio usuario
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros'])
        && request.resource.data.miembros.toSet().difference(resource.data.get('miembros', []).toSet()).hasOnly([request.auth.uid])
        && resource.data.get('miembros', []).toSet().difference(request.resource.data.miembros.toSet()).hasOnly([request.auth.uid]);

      match /bloques/{bloqueId} {
        function rocodromo() {
          return get(/databases/$(database)/documents/rocodromos/$(id)).data;
        }
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.creadoPor == request.auth.uid
          && request.auth.uid in rocodromo().miembros;
        allow delete: if request.auth != null
          && (resource.data.creadoPor == request.auth.uid || rocodromo().creadoPor == request.auth.uid);
        // El autor del bloque o del rocódromo cambia el bloque, no los ascensos de otros
        allow update: if request.auth != null
          && (resource.data.creadoPor == request.auth.uid || rocodromo().creadoPor == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'grado', 'presas', 'modalidades', 'observacion']);

        // Marcar o desmarcar «hecho» con su valoración: solo el propio usuario
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['encadenadoPor', 'valoraciones'])
          && request.resource.data.get('valoraciones', {}).diff(resource.data.get('valoraciones', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.get('valoraciones', {}))
              || (request.resource.data.valoraciones[request.auth.uid].estrellas is int
                  && request.resource.data.valoraciones[request.auth.uid].estrellas >= 1
                  && request.resource.data.valoraciones[request.auth.uid].estrellas <= 5))
          && request.resource.data.encadenadoPor.toSet().difference(resource.data.get('encadenadoPor', []).toSet()).hasOnly([request.auth.uid])
          && resource.data.get('encadenadoPor', []).toSet().difference(request.resource.data.encadenadoPor.toSet()).hasOnly([request.auth.uid]);
      }
    }

    // Itinerarios grabados con GPS: privados de quien los graba
    match /itinerarios_grabados/{id} {
      allow read, delete: if request.auth != null && resource.data.creadoPor == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.puntos is list;
      allow update: if request.auth != null && resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.puntos is list
        && request.resource.data.puntos.size() <= 2000;
    }

    // Entrenamiento: tests y planes privados de cada usuario
    match /tests_entrenamiento/{id} {
      allow read, delete: if request.auth != null && resource.data.creadoPor == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.creadoPor == request.auth.uid;
    }
    match /planes_entrenamiento/{id} {
      function esEntrenador() {
        return request.auth != null && request.auth.token.email in resource.data.get('entrenadoresEmail', []);
      }
      allow read, delete: if request.auth != null && resource.data.creadoPor == request.auth.uid;
      // Los entrenadores que el atleta ha añadido por email
      allow get: if esEntrenador();
      allow list: if request.auth != null && request.auth.token.email in resource.data.entrenadoresEmail;
      allow create: if request.auth != null && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.sesiones is list
        && request.resource.data.sesiones.size() <= 60;
      allow update: if request.auth != null && resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.sesiones == resource.data.sesiones;
      // El entrenador ajusta cargas, bloqueos, bloques extra, notas y comentarios; nunca las
      // sesiones, los registros del atleta ni la lista de entrenadores
      allow update: if esEntrenador()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ajustes', 'bloqueos', 'extras', 'notasEntrenador', 'comentarios', 'mensajeEntrenador', 'vistoPorEntrenador',
                       'sesiones', 'semanas', 'plantillaNombre', 'updatedAt'])
        && request.resource.data.sesiones is list
        && request.resource.data.sesiones.size() <= 80;
      // El entrenador se apunta (solo su uid) para recibir avisos de las sesiones
      allow update: if esEntrenador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entrenadoresUid'])
        && request.resource.data.entrenadoresUid.toSet().difference(resource.data.get('entrenadoresUid', []).toSet()).hasOnly([request.auth.uid])
        && resource.data.get('entrenadoresUid', []).toSet().difference(request.resource.data.entrenadoresUid.toSet()).size() == 0;
    }

    // Planes que diseña un entrenador (plantillas): solo los ve y edita él
    match /planes_entrenador/{id} {
      allow read, delete: if request.auth != null && resource.data.entrenadorUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.entrenadorUid == request.auth.uid
        && request.resource.data.sesiones is list && request.resource.data.sesiones.size() <= 80;
      allow update: if request.auth != null && resource.data.entrenadorUid == request.auth.uid
        && request.resource.data.entrenadorUid == request.auth.uid
        && request.resource.data.sesiones is list && request.resource.data.sesiones.size() <= 80;
    }

    // Invitación de un entrenador a un atleta (por email) para seguir uno de sus planes
    match /invitaciones_plan/{id} {
      allow create: if request.auth != null
        && request.resource.data.entrenadorUid == request.auth.uid
        && request.resource.data.entrenadorEmail == request.auth.token.email.lower()
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.atletaEmail is string;
      allow read: if request.auth != null && resource.data.entrenadorUid == request.auth.uid;
      allow read: if request.auth != null && resource.data.atletaEmail == request.auth.token.email.lower();
      // El entrenador actualiza el plan de las invitaciones pendientes o las cancela
      allow update: if request.auth != null && resource.data.entrenadorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'updatedAt']);
      allow delete: if request.auth != null && resource.data.entrenadorUid == request.auth.uid;
      // El atleta la acepta o la rechaza
      allow update: if request.auth != null && resource.data.atletaEmail == request.auth.token.email.lower()
        && resource.data.estado == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'planId', 'respondidaAt'])
        && request.resource.data.estado in ['aceptada', 'rechazada'];
    }

    // Catálogo de bloques de entrenamiento: los entrenadores proponen y la administración aprueba
    match /bloques_entrenamiento/{id} {
      function esAdmin() { return request.auth != null && request.auth.token.email == 'goladen@gmail.com'; }
      allow read: if resource.data.estado == 'aprobado';
      allow read: if request.auth != null && resource.data.autorUid == request.auth.uid;
      allow read, update, delete: if esAdmin();
      allow create: if request.auth != null
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.keys().hasOnly(['autorUid', 'autorNombre', 'nombre', 'categoria', 'descripcion', 'ejercicio', 'estado', 'createdAt'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
        && request.resource.data.descripcion.size() <= 1000;
      // Quien lo propuso puede retirarlo mientras está pendiente
      allow delete: if request.auth != null && resource.data.autorUid == request.auth.uid && resource.data.estado == 'pendiente';
    }

    // Sesiones propias con crono. El id es el enlace para compartir: cualquiera con cuenta
    // que lo conozca la abre; en las listas solo salen las propias y las compartidas por email.
    match /sesiones_propias/{id} {
      function valida() {
        return request.resource.data.creadoPor == request.auth.uid
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
          && request.resource.data.ejercicios is list
          && request.resource.data.ejercicios.size() <= 40
          && request.resource.data.compartidaConEmail is list
          && request.resource.data.compartidaConEmail.size() <= 50;
      }
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.creadoPor == request.auth.uid;
      allow list: if request.auth != null && request.auth.token.email in resource.data.compartidaConEmail;
      allow create: if request.auth != null && valida();
      allow update: if request.auth != null && resource.data.creadoPor == request.auth.uid && valida();
      allow delete: if request.auth != null && resource.data.creadoPor == request.auth.uid;
      // Quien la recibió por email puede quitarse de la lista
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['compartidaConEmail'])
        && request.auth.token.email in resource.data.compartidaConEmail
        && request.resource.data.compartidaConEmail.toSet() == resource.data.compartidaConEmail.toSet().difference([request.auth.token.email].toSet());
    }

    // Notificaciones: cada usuario lee/borra las suyas; cualquier autenticado puede crear
    match /notificaciones/{uid}/items/{itemId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
    }
  }
}
