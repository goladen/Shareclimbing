rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /croquis_escalada/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creadoPor;

      // El autor cambia lo que quiera
      allow update: if request.auth != null && request.auth.uid == resource.data.creadoPor;

      // Editores aceptados o invitados: el contenido, nunca el autor ni la lista de editores
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.get('editores', [])
            || request.auth.token.email in resource.data.get('editoresEmail', []))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['infoCroquis', 'fotos', 'imagenUrl', 'vias', 'formas', 'visibilidad', 'updatedAt']);

      // Proponer cambios al autor: solo añadir una capa
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['capas'])
        && request.resource.data.capas.size() == resource.data.get('capas', []).size() + 1;

      // Quien creó una escuela puede sacar de ella un croquis (solo vaciar el campo escuela).
      // desvinculadoDe indica la escuela, y se comprueba que el croquis pertenece a ella.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['infoCroquis', 'desvinculadoDe'])
        && request.resource.data.infoCroquis.diff(resource.data.infoCroquis).affectedKeys().hasOnly(['escuela'])
        && request.resource.data.infoCroquis.escuela == ''
        && get(/databases/$(database)/documents/escuelas/$(request.resource.data.desvinculadoDe)).data.creadoPor == request.auth.uid
        && get(/databases/$(database)/documents/escuelas/$(request.resource.data.desvinculadoDe)).data.nombre.trim().lower()
             == resource.data.infoCroquis.escuela.trim().lower();

      // Comentarios en subcollección
      match /comentarios/{comentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.autorUid ||
          request.auth.uid == get(/databases/$(database)/documents/croquis_escalada/$(docId)).data.creadoPor ||
          request.auth.token.email == 'goladen@gmail.com'
        );
      }
    }

    // Enlaces de tarjeta de vía. El id del documento es el secreto: se puede abrir
    // conociéndolo, pero solo quien lo creó puede listar los suyos.
    match /tarjetas_via/{token} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.creadoPor == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.creadoPor == request.auth.uid
        && (get(/databases/$(database)/documents/croquis_escalada/$(request.resource.data.croquisId)).data.creadoPor == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/croquis_escalada/$(request.resource.data.croquisId)).data.get('editores', [])
            || request.auth.token.email in get(/databases/$(database)/documents/croquis_escalada/$(request.resource.data.croquisId)).data.get('editoresEmail', []));
      allow delete: if request.auth != null && (resource.data.creadoPor == request.auth.uid
        || get(/databases/$(database)/documents/croquis_escalada/$(resource.data.croquisId)).data.creadoPor == request.auth.uid);
    }

    // Propuestas enviadas desde una tarjeta de vía, sin necesidad de registrarse.
    // Solo se aceptan con un enlace vigente y van dirigidas a quien lo creó.
    match /propuestas_via/{id} {
      function tarjeta() {
        return get(/databases/$(database)/documents/tarjetas_via/$(request.resource.data.token)).data;
      }
      allow create: if request.resource.data.keys().hasOnly(['token', 'croquisId', 'viaId', 'paraUid', 'autorNombre', 'cambios', 'estado', 'createdAt'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.autorNombre is string
        && request.resource.data.autorNombre.size() > 0 && request.resource.data.autorNombre.size() <= 60
        && request.resource.data.cambios.keys().hasOnly(['info', 'trazado'])
        && tarjeta().croquisId == request.resource.data.croquisId
        && tarjeta().viaId == request.resource.data.viaId
        && tarjeta().creadoPor == request.resource.data.paraUid;
      allow read, delete: if request.auth != null && resource.data.paraUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.paraUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
    }

    // Fichas de equipadores: se crean al indicar el equipador de una vía
    match /equipadores/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0;
      allow update, delete: if request.auth != null && resource.data.creadoPor == request.auth.uid;
    }

    match /solicitudes_edicion/{id} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.autorUid ||
        request.auth.uid == resource.data.solicitanteUid
      );
      allow create: if request.auth != null
        && request.resource.data.solicitanteUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.autorUid == request.auth.uid;
    }

    match /escuelas/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.creadoPor;
    }

    match /rocodromos/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.creadoPor == request.auth.uid;
      allow delete: if request.auth != null && resource.data.creadoPor == request.auth.uid;
      allow update: if request.auth != null && resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPor == request.auth.uid;

      // Hacerse miembro o dejar de serlo: solo el propio usuario
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros'])
        && request.resource.data.miembros.toSet().difference(resource.data.get('miembros', []).toSet()).hasOnly([request.auth.uid])
        && resource.data.get('miembros', []).toSet().difference(request.resource.data.miembros.toSet()).hasOnly([request.auth.uid]);

      match /bloques/{bloqueId} {
        function rocodromo() {
          return get(/databases/$(database)/documents/rocodromos/$(id)).data;
        }
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.creadoPor == request.auth.uid
          && request.auth.uid in rocodromo().miembros;
        allow delete: if request.auth != null
          && (resource.data.creadoPor == request.auth.uid || rocodromo().creadoPor == request.auth.uid);
        // El autor del bloque o del rocódromo cambia el bloque, no los ascensos de otros
        allow update: if request.auth != null
          && (resource.data.creadoPor == request.auth.uid || rocodromo().creadoPor == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'grado', 'presas']);

        // Marcar o desmarcar «hecho» con su valoración: solo el propio usuario
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['encadenadoPor', 'valoraciones'])
          && request.resource.data.get('valoraciones', {}).diff(resource.data.get('valoraciones', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.get('valoraciones', {}))
              || (request.resource.data.valoraciones[request.auth.uid].estrellas is int
                  && request.resource.data.valoraciones[request.auth.uid].estrellas >= 1
                  && request.resource.data.valoraciones[request.auth.uid].estrellas <= 5))
          && request.resource.data.encadenadoPor.toSet().difference(resource.data.get('encadenadoPor', []).toSet()).hasOnly([request.auth.uid])
          && resource.data.get('encadenadoPor', []).toSet().difference(request.resource.data.encadenadoPor.toSet()).hasOnly([request.auth.uid]);
      }
    }

    // Notificaciones: cada usuario lee/borra las suyas; cualquier autenticado puede crear
    match /notificaciones/{uid}/items/{itemId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
    }
  }
}
